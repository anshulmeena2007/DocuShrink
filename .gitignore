# DocuHug .gitignore
# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
temp/

# Python Cache & Local Server artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Scratch / Local test artifacts
scratch/

# Secrets & Environment variables
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
